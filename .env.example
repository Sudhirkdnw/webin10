# ========================================================
# Webin10 Multi-Tenant Platform Environment Template
# ========================================================

# Node Environment & Ports
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
SUPER_ADMIN_URL=http://localhost:3001
BUSINESS_ADMIN_URL=http://localhost:3002

# Allowed CORS Origins (Comma-separated list of allowed URLs or domains)
CORS_ORIGINS=https://admin.yourdomain.com,https://app.yourdomain.com,http://localhost:3000,http://localhost:3001,http://localhost:3002

# Meta WhatsApp Cloud API & Webhook Configuration
# Strict verify token for Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
META_WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_secret
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Frontend Public API URL (For Next.js client-side requests)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://webin10_admin:webin10_secret@localhost:5432/webin10_db?schema=public

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=super-secret-access-key-replace-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Super Admin Initial Seed
SUPER_ADMIN_EMAIL=superadmin@webin10.com
SUPER_ADMIN_PASSWORD=ChangeMeInProduction123!
