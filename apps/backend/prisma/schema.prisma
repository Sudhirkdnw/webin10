datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. PLATFORM IDENTITY & GOVERNANCE
// -------------------------------------------------------------

enum PlatformRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_FINANCE
  PLATFORM_OPERATIONS
  PLATFORM_ANALYST
}

model PlatformAdmin {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         PlatformRole @default(SUPER_ADMIN)
  avatarUrl    String?      @map("avatar_url")
  mfaSecret    String?      @map("mfa_secret")
  mfaEnabled   Boolean      @default(false) @map("mfa_enabled")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions     PlatformSession[]
  auditLogs    AuditLog[]
  supportRequests SupportAccessRequest[]

  @@map("platform_admins")
}

model PlatformSession {
  id           String        @id @default(uuid()) @db.Uuid
  adminId      String        @map("admin_id") @db.Uuid
  tokenHash    String        @map("token_hash")
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("platform_sessions")
}

// -------------------------------------------------------------
// 2. TENANTS & BUSINESS VERTICALS
// -------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_ONBOARDING
  DEACTIVATED
}

model BusinessCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenants         Tenant[]
  categoryModules CategoryModule[]
  announcements   PlatformAnnouncement[]

  @@map("business_categories")
}

model Tenant {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  status       TenantStatus     @default(ACTIVE)
  categoryId   String           @map("category_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  category     BusinessCategory @relation(fields: [categoryId], references: [id])
  profile      BusinessProfile?
  branches     Branch[]
  members      TenantMember[]
  modules      TenantModule[]
  subscriptions TenantSubscription[]
  invoices     PlatformInvoice[]
  featureOverrides TenantFeatureOverride[]
  auditLogs    AuditLog[]
  supportRequests SupportAccessRequest[]
  customers       Customer[]
  whatsAppAccount WhatsAppAccount?
  whatsAppTemplates WhatsAppTemplate[]
  whatsAppCampaigns WhatsAppCampaign[]
  whatsAppLogs    WhatsAppMessageLog[]
  whatsAppAutomations WhatsAppAutomationRule[]

  @@index([status])
  @@index([categoryId])
  @@map("tenants")
}

model BusinessProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  legalName    String?  @map("legal_name")
  taxId        String?  @map("tax_id") // GSTIN
  phone        String
  email        String
  address      String?
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  phone     String?
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("branches")
}

// -------------------------------------------------------------
// 3. TENANT USERS & RBAC
// -------------------------------------------------------------

enum TenantRole {
  BUSINESS_OWNER
  BUSINESS_MANAGER
  BRANCH_MANAGER
  RECEPTIONIST
  TRAINER
  TEACHER
  ACCOUNTANT
  CUSTOM_STAFF
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String?        @unique
  phone        String?        @unique
  name         String
  avatarUrl    String?        @map("avatar_url")
  passwordHash String?        @map("password_hash")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  memberships  TenantMember[]

  @@map("users")
}

model TenantMember {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole @default(BUSINESS_OWNER)
  isActive  Boolean    @default(true) @map("is_active")
  joinedAt  DateTime   @default(now()) @map("joined_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

// -------------------------------------------------------------
// 4. MODULES & FEATURE FLAGS
// -------------------------------------------------------------

model PlatformModule {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. 'crm', 'billing', 'attendance'
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  categoryModules CategoryModule[]
  tenantModules   TenantModule[]

  @@map("platform_modules")
}

model CategoryModule {
  id         String         @id @default(uuid()) @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  moduleId   String         @map("module_id") @db.Uuid
  isDefault  Boolean        @default(true) @map("is_default")

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  module     PlatformModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([categoryId, moduleId])
  @@map("category_modules")
}

model TenantModule {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  moduleId  String         @map("module_id") @db.Uuid
  isEnabled Boolean        @default(true) @map("is_enabled")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")

  overrides   TenantFeatureOverride[]

  @@map("feature_flags")
}

model TenantFeatureOverride {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  flagId    String      @map("flag_id") @db.Uuid
  isEnabled Boolean     @map("is_enabled")

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagId])
  @@map("tenant_feature_overrides")
}

// -------------------------------------------------------------
// 5. PLANS & SUBSCRIPTIONS
// -------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Int      @map("price_monthly") // in INR paise or rupees
  maxCustomers Int      @default(100) @map("max_customers")
  maxStaff     Int      @default(2) @map("max_staff")
  maxBranches  Int      @default(1) @map("max_branches")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions TenantSubscription[]
  announcements PlatformAnnouncement[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("tenant_subscriptions")
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  VOID
  REFUNDED
}

model PlatformInvoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique @map("invoice_number")
  tenantId           String        @map("tenant_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  planName           String        @map("plan_name")
  amountSubtotal     Decimal       @map("amount_subtotal") @db.Decimal(10, 2)
  taxPercentage      Decimal       @default(18.0) @map("tax_percentage") @db.Decimal(5, 2)
  cgstAmount         Decimal       @default(0.0) @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount         Decimal       @default(0.0) @map("sgst_amount") @db.Decimal(10, 2)
  igstAmount         Decimal       @default(0.0) @map("igst_amount") @db.Decimal(10, 2)
  taxAmount          Decimal       @map("tax_amount") @db.Decimal(10, 2)
  amountTotal        Decimal       @map("amount_total") @db.Decimal(10, 2)
  hsnCode            String        @default("998313") @map("hsn_code")
  status             InvoiceStatus @default(PAID)
  billingPeriodStart DateTime      @map("billing_period_start")
  billingPeriodEnd   DateTime      @map("billing_period_end")
  paidAt             DateTime?     @map("paid_at")
  paymentMethod      String        @default("RAZORPAY") @map("payment_method")
  paymentReference   String?       @map("payment_reference")
  customerName       String        @map("customer_name")
  customerEmail      String        @map("customer_email")
  customerPhone      String?       @map("customer_phone")
  customerGstin      String?       @map("customer_gstin")
  customerAddress    String?       @map("customer_address")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("platform_invoices")
}

// -------------------------------------------------------------
// 6. DYNAMIC CONFIGURATION & AUDIT LOGS
// -------------------------------------------------------------

model ConfigurationDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  dataType    String   @map("data_type") // string, number, boolean, json
  defaultValue String  @map("default_value")
  isPublic    Boolean  @default(false) @map("is_public")
  description String?

  values      ConfigurationValue[]
  versions    ConfigurationVersion[]

  @@map("configuration_definitions")
}

model ConfigurationValue {
  id           String                  @id @default(uuid()) @db.Uuid
  definitionId String                  @map("definition_id") @db.Uuid
  tenantId     String?                 @map("tenant_id") @db.Uuid // null = platform level
  value        String
  version      Int                     @default(1)
  updatedAt    DateTime                @updatedAt @map("updated_at")

  definition   ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, tenantId])
  @@map("configuration_values")
}

model ConfigurationVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  definitionId  String                  @map("definition_id") @db.Uuid
  tenantId      String?                 @map("tenant_id") @db.Uuid // null = platform level
  version       Int
  value         String
  previousValue String?                 @map("previous_value")
  reason        String?
  changedById   String                  @map("changed_by_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at")

  definition    ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, tenantId])
  @@map("configuration_versions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  actorType String   @map("actor_type") // PLATFORM_ADMIN or TENANT_USER
  tenantId  String?  @map("tenant_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  admin     PlatformAdmin? @relation(fields: [actorId], references: [id], map: "audit_actor_admin_fkey")
  tenant    Tenant?        @relation(fields: [tenantId], references: [id], map: "audit_tenant_fkey")

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 7. PLATFORM INTEGRATIONS (PAYMENT & WHATSAPP)
// -------------------------------------------------------------

enum IntegrationType {
  PAYMENT_GATEWAY
  WHATSAPP
  SMS
  EMAIL
}

enum IntegrationProvider {
  RAZORPAY
  CASHFREE
  META_WHATSAPP
  MSG91
  AWS_SES
  RESEND
}

model PlatformIntegration {
  id           String              @id @default(uuid()) @db.Uuid
  type         IntegrationType
  provider     IntegrationProvider @unique
  name         String
  isEnabled    Boolean             @default(false) @map("is_enabled")
  isTestMode   Boolean             @default(true) @map("is_test_mode")
  credentials  Json?
  settings     Json?
  healthStatus String              @default("UNKNOWN") @map("health_status")
  lastCheckedAt DateTime?          @map("last_checked_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("platform_integrations")
}

// -------------------------------------------------------------
// 8. GOVERNANCE & PRIVILEGED SUPPORT ACCESS
// -------------------------------------------------------------

enum SupportAccessStatus {
  PENDING
  APPROVED
  EXPIRED
  REVOKED
}

model SupportAccessRequest {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  adminId       String              @map("admin_id") @db.Uuid
  reason        String
  durationHours Int                 @default(2) @map("duration_hours")
  status        SupportAccessStatus @default(PENDING)
  expiresAt     DateTime?           @map("expires_at")
  approvedById  String?             @map("approved_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin         PlatformAdmin       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([adminId])
  @@index([status])
  @@map("support_access_requests")
}

// -------------------------------------------------------------
// 9. PLATFORM SYSTEM SETTINGS & EMAIL TEMPLATES
// -------------------------------------------------------------

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  group     String   // general, terms, google, payment, homepage, recaptcha, social, mail, custom_domain, theme
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false) @map("is_public")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("system_settings")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  category    String   @default("SYSTEM") // AUTH, BILLING, SUBSCRIPTION, SYSTEM, ONBOARDING
  subject     String
  bodyHtml    String   @map("body_html") @db.Text
  bodyText    String?  @map("body_text") @db.Text
  variables   Json     @default("[]") // e.g. ["app_name", "user_name", "login_url", "plan_name"]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// -------------------------------------------------------------
// 10. CUSTOMER CRM & MULTI-TENANT WHATSAPP MARKETING & AUTOMATION
// -------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  LEAD
}

enum CustomerType {
  GYM_MEMBER
  COACHING_STUDENT
  GENERAL
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  firstName      String         @map("first_name")
  lastName       String?        @map("last_name")
  phone          String
  email          String?
  status         CustomerStatus @default(ACTIVE)
  customerType   CustomerType   @default(GENERAL) @map("customer_type")
  avatarUrl      String?        @map("avatar_url")
  membershipPlan String?        @map("membership_plan")
  pendingAmount  Decimal        @default(0.0) @map("pending_amount") @db.Decimal(10, 2)
  expiryDate     DateTime?      @map("expiry_date")
  joinedAt       DateTime       @default(now()) @map("joined_at")
  notes          String?        @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsAppLogs   WhatsAppMessageLog[]

  @@index([tenantId])
  @@index([phone])
  @@index([status])
  @@map("customers")
}

enum WhatsAppAccountMode {
  EMBEDDED_WABA
  SHARED_PLATFORM
  CUSTOM_TOKEN
}

enum WhatsAppConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

model WhatsAppAccount {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @unique @map("tenant_id") @db.Uuid
  mode               WhatsAppAccountMode      @default(SHARED_PLATFORM)
  status             WhatsAppConnectionStatus @default(CONNECTED)
  phoneNumberId      String?                  @map("phone_number_id")
  wabaId             String?                  @map("waba_id")
  displayPhoneNumber String?                  @map("display_phone_number")
  qualityRating      String                   @default("GREEN") @map("quality_rating")
  creditsBalance     Decimal                  @default(100.0) @map("credits_balance") @db.Decimal(10, 2)
  isEnabled          Boolean                  @default(true) @map("is_enabled")
  isBlocked          Boolean                  @default(false) @map("is_blocked")
  blockReason        String?                  @map("block_reason")
  accessToken        String?                  @map("access_token") @db.Text
  settings           Json?
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  DRAFT
}

model WhatsAppTemplate {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String?                  @map("tenant_id") @db.Uuid
  name            String
  code            String                   @unique
  language        String                   @default("en_US")
  category        WhatsAppTemplateCategory @default(UTILITY)
  status          WhatsAppTemplateStatus   @default(APPROVED)
  headerType      String                   @default("NONE") @map("header_type") // NONE, IMAGE, VIDEO, DOCUMENT
  headerUrl       String?                  @map("header_url")
  bodyText        String                   @map("body_text") @db.Text
  footerText      String?                  @map("footer_text")
  buttons         Json?                    // Quick reply, URL CTA, Phone call
  sampleVariables Json?                    @map("sample_variables") // ["Rahul", "FitZone Gym", "Rs 1,500", "28 Nov"]
  isSystemDefault Boolean                  @default(false) @map("is_system_default")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  tenant          Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns       WhatsAppCampaign[]

  @@index([tenantId])
  @@index([category])
  @@map("whatsapp_templates")
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model WhatsAppCampaign {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  name           String
  templateId     String                 @map("template_id") @db.Uuid
  targetSegment  String                 @default("ALL_ACTIVE") @map("target_segment") // ALL_ACTIVE, EXPIRED_MEMBERS, FEE_DUE, CUSTOM_LIST
  scheduledAt    DateTime?              @map("scheduled_at")
  status         WhatsAppCampaignStatus @default(DRAFT)
  totalCount     Int                    @default(0) @map("total_count")
  sentCount      Int                    @default(0) @map("sent_count")
  deliveredCount Int                    @default(0) @map("delivered_count")
  readCount      Int                    @default(0) @map("read_count")
  failedCount    Int                    @default(0) @map("failed_count")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       WhatsAppTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  logs           WhatsAppMessageLog[]

  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_campaigns")
}

enum WhatsAppMessageDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessageLog {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String?                  @map("tenant_id") @db.Uuid
  campaignId      String?                  @map("campaign_id") @db.Uuid
  customerId      String?                  @map("customer_id") @db.Uuid
  recipientPhone  String                   @map("recipient_phone")
  recipientName   String?                  @map("recipient_name")
  direction       WhatsAppMessageDirection @default(OUTBOUND)
  status          WhatsAppMessageStatus    @default(SENT)
  content         String                   @db.Text
  templateCode    String?                  @map("template_code")
  metaMessageId   String?                  @map("meta_message_id")
  errorMessage    String?                  @map("error_message")
  sentAt          DateTime                 @default(now()) @map("sent_at")
  deliveredAt     DateTime?                @map("delivered_at")
  readAt          DateTime?                @map("read_at")
  createdAt       DateTime                 @default(now()) @map("created_at")

  tenant          Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        WhatsAppCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customer        Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([recipientPhone])
  @@index([status])
  @@index([direction])
  @@map("whatsapp_message_logs")
}

enum WhatsAppAutomationEventType {
  MEMBER_WELCOME
  FEE_REMINDER_DUE
  FEE_OVERDUE
  PAYMENT_RECEIPT
  CLASS_ABSENT
  MEMBERSHIP_EXPIRED
  FESTIVAL_BROADCAST
  PLATFORM_TENANT_WELCOME
  PLATFORM_PLAN_EXPIRY_7D
  PLATFORM_PLAN_EXPIRY_3D
  PLATFORM_SUBSCRIPTION_INVOICE
}

model WhatsAppAutomationRule {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String?                     @map("tenant_id") @db.Uuid
  eventType     WhatsAppAutomationEventType @map("event_type")
  name          String
  isEnabled     Boolean                     @default(true) @map("is_enabled")
  templateCode  String                      @map("template_code")
  triggerTiming Int                         @default(0) @map("trigger_timing") // 0 = Instant, -3 = 3 days before, 1 = 1 day after
  parameters    Json?
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  tenant        Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_automation_rules")
}

// -------------------------------------------------------------
// 12. PLATFORM-WIDE DASHBOARD ANNOUNCEMENTS & BANNERS
// -------------------------------------------------------------

enum AnnouncementType {
  INFO
  SUCCESS
  WARNING
  CRITICAL
  PROMOTION
}

enum AnnouncementDisplayType {
  TOP_BANNER
  MODAL_POPUP
}

enum AnnouncementAudience {
  ALL_BUSINESSES
  SPECIFIC_CATEGORY
  SPECIFIC_PLAN
}

model PlatformAnnouncement {
  id               String                  @id @default(uuid()) @db.Uuid
  title            String
  message          String                  @db.Text
  type             AnnouncementType        @default(INFO)
  displayType      AnnouncementDisplayType @default(TOP_BANNER) @map("display_type")
  targetAudience   AnnouncementAudience    @default(ALL_BUSINESSES) @map("target_audience")
  targetCategoryId String?                 @map("target_category_id") @db.Uuid
  targetPlanId     String?                 @map("target_plan_id") @db.Uuid
  ctaText          String?                 @map("cta_text")
  ctaUrl           String?                 @map("cta_url")
  isDismissible    Boolean                 @default(true) @map("is_dismissible")
  isActive         Boolean                 @default(true) @map("is_active")
  startsAt         DateTime?               @map("starts_at")
  expiresAt        DateTime?               @map("expires_at")
  priority         Int                     @default(0)
  createdById      String?                 @map("created_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  category         BusinessCategory?       @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  plan             SubscriptionPlan?       @relation(fields: [targetPlanId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([targetAudience])
  @@index([startsAt, expiresAt])
  @@map("platform_announcements")
}


