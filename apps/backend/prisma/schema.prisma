datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. PLATFORM IDENTITY & GOVERNANCE
// -------------------------------------------------------------

enum PlatformRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_FINANCE
  PLATFORM_OPERATIONS
  PLATFORM_ANALYST
}

model PlatformAdmin {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         PlatformRole @default(SUPER_ADMIN)
  mfaSecret    String?      @map("mfa_secret")
  mfaEnabled   Boolean      @default(false) @map("mfa_enabled")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions     PlatformSession[]
  auditLogs    AuditLog[]
  supportRequests SupportAccessRequest[]

  @@map("platform_admins")
}

model PlatformSession {
  id           String        @id @default(uuid()) @db.Uuid
  adminId      String        @map("admin_id") @db.Uuid
  tokenHash    String        @map("token_hash")
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("platform_sessions")
}

// -------------------------------------------------------------
// 2. TENANTS & BUSINESS VERTICALS
// -------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_ONBOARDING
  DEACTIVATED
}

model BusinessCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenants         Tenant[]
  categoryModules CategoryModule[]

  @@map("business_categories")
}

model Tenant {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  status       TenantStatus     @default(ACTIVE)
  categoryId   String           @map("category_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  category     BusinessCategory @relation(fields: [categoryId], references: [id])
  profile      BusinessProfile?
  branches     Branch[]
  members      TenantMember[]
  modules      TenantModule[]
  subscriptions TenantSubscription[]
  featureOverrides TenantFeatureOverride[]
  auditLogs    AuditLog[]
  supportRequests SupportAccessRequest[]

  @@index([status])
  @@index([categoryId])
  @@map("tenants")
}

model BusinessProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  legalName    String?  @map("legal_name")
  taxId        String?  @map("tax_id") // GSTIN
  phone        String
  email        String
  address      String?
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  phone     String?
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("branches")
}

// -------------------------------------------------------------
// 3. TENANT USERS & RBAC
// -------------------------------------------------------------

enum TenantRole {
  BUSINESS_OWNER
  BUSINESS_MANAGER
  BRANCH_MANAGER
  RECEPTIONIST
  TRAINER
  TEACHER
  ACCOUNTANT
  CUSTOM_STAFF
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String?        @unique
  phone        String?        @unique
  name         String
  passwordHash String?        @map("password_hash")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  memberships  TenantMember[]

  @@map("users")
}

model TenantMember {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole @default(BUSINESS_OWNER)
  isActive  Boolean    @default(true) @map("is_active")
  joinedAt  DateTime   @default(now()) @map("joined_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

// -------------------------------------------------------------
// 4. MODULES & FEATURE FLAGS
// -------------------------------------------------------------

model PlatformModule {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. 'crm', 'billing', 'attendance'
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  categoryModules CategoryModule[]
  tenantModules   TenantModule[]

  @@map("platform_modules")
}

model CategoryModule {
  id         String         @id @default(uuid()) @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  moduleId   String         @map("module_id") @db.Uuid
  isDefault  Boolean        @default(true) @map("is_default")

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  module     PlatformModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([categoryId, moduleId])
  @@map("category_modules")
}

model TenantModule {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  moduleId  String         @map("module_id") @db.Uuid
  isEnabled Boolean        @default(true) @map("is_enabled")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")

  overrides   TenantFeatureOverride[]

  @@map("feature_flags")
}

model TenantFeatureOverride {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  flagId    String      @map("flag_id") @db.Uuid
  isEnabled Boolean     @map("is_enabled")

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagId])
  @@map("tenant_feature_overrides")
}

// -------------------------------------------------------------
// 5. PLANS & SUBSCRIPTIONS
// -------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Int      @map("price_monthly") // in INR paise or rupees
  maxCustomers Int      @default(100) @map("max_customers")
  maxStaff     Int      @default(2) @map("max_staff")
  maxBranches  Int      @default(1) @map("max_branches")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("tenant_subscriptions")
}

// -------------------------------------------------------------
// 6. DYNAMIC CONFIGURATION & AUDIT LOGS
// -------------------------------------------------------------

model ConfigurationDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  dataType    String   @map("data_type") // string, number, boolean, json
  defaultValue String  @map("default_value")
  isPublic    Boolean  @default(false) @map("is_public")
  description String?

  values      ConfigurationValue[]
  versions    ConfigurationVersion[]

  @@map("configuration_definitions")
}

model ConfigurationValue {
  id           String                  @id @default(uuid()) @db.Uuid
  definitionId String                  @map("definition_id") @db.Uuid
  tenantId     String?                 @map("tenant_id") @db.Uuid // null = platform level
  value        String
  version      Int                     @default(1)
  updatedAt    DateTime                @updatedAt @map("updated_at")

  definition   ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, tenantId])
  @@map("configuration_values")
}

model ConfigurationVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  definitionId  String                  @map("definition_id") @db.Uuid
  tenantId      String?                 @map("tenant_id") @db.Uuid // null = platform level
  version       Int
  value         String
  previousValue String?                 @map("previous_value")
  reason        String?
  changedById   String                  @map("changed_by_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at")

  definition    ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, tenantId])
  @@map("configuration_versions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  actorType String   @map("actor_type") // PLATFORM_ADMIN or TENANT_USER
  tenantId  String?  @map("tenant_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  admin     PlatformAdmin? @relation(fields: [actorId], references: [id], map: "audit_actor_admin_fkey")
  tenant    Tenant?        @relation(fields: [tenantId], references: [id], map: "audit_tenant_fkey")

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 7. PLATFORM INTEGRATIONS (PAYMENT & WHATSAPP)
// -------------------------------------------------------------

enum IntegrationType {
  PAYMENT_GATEWAY
  WHATSAPP
  SMS
  EMAIL
}

enum IntegrationProvider {
  RAZORPAY
  CASHFREE
  META_WHATSAPP
  MSG91
  AWS_SES
  RESEND
}

model PlatformIntegration {
  id           String              @id @default(uuid()) @db.Uuid
  type         IntegrationType
  provider     IntegrationProvider @unique
  name         String
  isEnabled    Boolean             @default(false) @map("is_enabled")
  isTestMode   Boolean             @default(true) @map("is_test_mode")
  credentials  Json?
  settings     Json?
  healthStatus String              @default("UNKNOWN") @map("health_status")
  lastCheckedAt DateTime?          @map("last_checked_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("platform_integrations")
}

// -------------------------------------------------------------
// 8. GOVERNANCE & PRIVILEGED SUPPORT ACCESS
// -------------------------------------------------------------

enum SupportAccessStatus {
  PENDING
  APPROVED
  EXPIRED
  REVOKED
}

model SupportAccessRequest {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  adminId       String              @map("admin_id") @db.Uuid
  reason        String
  durationHours Int                 @default(2) @map("duration_hours")
  status        SupportAccessStatus @default(PENDING)
  expiresAt     DateTime?           @map("expires_at")
  approvedById  String?             @map("approved_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin         PlatformAdmin       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([adminId])
  @@index([status])
  @@map("support_access_requests")
}
